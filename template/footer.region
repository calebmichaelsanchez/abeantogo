      <!--Footer with open block field -->
      <footer class="footer">
        <div id="mobile-ordering" class="hero-divider hero-divider--two">
          <div class="hero-divider__inner">
            <h2 class="h2-home h2-home--small">Order online and pick up&nbsp;in&nbsp;store!</h2>
            <br />
            <h3>Download the app</h3>
            <a class="btn" target="_new" href="https://apps.apple.com/us/app/abeantogo/id6747405442">app store</a><a class="btn" target="_new" href="https://play.google.com/store/apps/details?id=com.tryperdiem.wh.abeantogo&pcampaignid=web_share">google play</a>
          </div>
        </div>
        <div class="footer__banner"></div>
        <div class="footer__social">
          <div class="footer__social-inner">
            <squarespace:block-field id="footerSocial" columns="12"/>
          </div>
        </div>
        <div class="footer__info">
          <div class="footer__item">
            <div class="footer__title">Goodrich</div>
            <squarespace:block-field id="blockField1" columns="12"/>
          </div>
          <div class="footer__item">
            <div class="footer__title">Lake&nbsp;Orion</div>
            <squarespace:block-field id="blockField2" columns="12"/>
          </div>
        </div>
      </footer>

    </div>
    <a href="#mobile-ordering" class="mobile-ordering-btn slide-link">Mobile Ordering</a>
    <!-- combo and minify scripts when not logged in -->
    <!-- React does not like being combo-ed!!!!!!!!! -->
    <squarespace:script src="app.js" />
    <squarespace:script src="site.js" />

    <!-- other scripts, and footer code injection -->
    {squarespace-footers}

  </body>
</html>
